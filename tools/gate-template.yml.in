name: Architect Review Gate

# GENERATED by tools/render-gate.sh from tools/gate-template.yml.in, tools/gate-resolve.sh and
# tools/gate-post.sh in 603-Identity/devcontainers. The `run:` blocks below are those scripts,
# byte for byte; that repo's selftest fails when they differ. In a consuming repo, edit only
# the PER-CONSUMER regions (marked `>>> CONSUMER` / `<<< CONSUMER`), never the logic.
#
# Per-consumer values, and nothing else:
#   * the `case` block in the `post` job's run block: this repo's code_paths, as globs.
#     The `.github/` rule just above it is NOT consumer-editable: a changed file under
#     `.github/` is always in review scope, whatever the list says. That is what makes a pin
#     bump of `decide` (which edits only .github/) always need review.
#   * REVIEWER_IDS, HEADER and ATTESTATION in the workflow-level `env` below.
#   * the `decide` pin, as `@<sha> # vX.Y` (a bare tag fails the reusable workflow's SHA check).
#
# review.ci_gate (.ai/project.yml): stays red on a PR that touches code_paths until a
# fresh-session review is posted, as a PR comment or a formal PR review, against the PR's
# CURRENT head commit. HEADER and ATTESTATION must match review.ci_gate.header/.attestation
# in .ai/project.yml byte for byte. This is a literal substring match, not an intent match: a
# paraphrase turns the check red, and the failure looks like a review problem.
#
# This is an EXISTENCE gate, not a verdict gate. It checks that a fresh-session review was
# posted, not what the review concluded; the human still reads it before merging. A comment
# or review counts only when its author's numeric user ID is in REVIEWER_IDS, since anyone
# can paste the two strings. Not author_association: org membership can be private, and this
# job's token then reads it as CONTRIBUTOR. IDs, not logins, because a released login can be
# claimed by someone else.
#
# Three jobs. `resolve` reads API facts only (it parses no PR content) and decides whether the
# run acts and whether the head commit is a candidate for the verified-image-bump exemption.
# `decide` is the reusable workflow that fully verifies a candidate. `post` is the only job
# with a write token, and the one place the `architect-review` status is decided. `resolve`
# and `post` have `run:` steps only (no `uses:`), so upstream action code, which Dependabot
# bumps, never shares a runner with the status token. No job is named `architect-review`, so
# no job check-run collides with the status of that name.
#
# For issue_comment events, GitHub attaches the job's implicit check-run to the DEFAULT
# BRANCH's tip, not the PR's head, so `post` posts the commit STATUS against the head SHA it
# resolved. The job exits 0 when no review is found: enforcement lives entirely in the status.
#
# issue_comment runs use the workflow file on the DEFAULT branch; pull_request and
# pull_request_review runs use the PR's own copy. So a comment re-evaluates a PR with main's
# gate, and a formal review with the PR's.

on:
  pull_request:
    types: [opened, synchronize, reopened]
  issue_comment:
    types: [created]
  pull_request_review:
    types: [submitted]

permissions: {}

# >>> CONSUMER: review values
env:
  # Space-separated numeric GitHub user IDs whose comment or review counts.
  # 281693088 = JaredGroves-603. A PR changing this list is checked by its own edited copy on
  # pull_request and pull_request_review runs, so the human's merge is the real control on it.
  REVIEWER_IDS: "281693088"
  HEADER: "**Opus/Architect HITL review (automated)**"
  ATTESTATION: "*Fresh-session review: this session did not author the diff.*"
  CONTEXT: architect-review
# <<< CONSUMER: review values

jobs:
  resolve:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    # issue_comment also fires for comments on plain issues; only the PR case has
    # github.event.issue.pull_request.
    if: github.event_name != 'issue_comment' || github.event.issue.pull_request != null
    permissions:
      contents: read        # the PR's head SHA, files and commits
      pull-requests: read
      issues: read
    outputs:
      act: ${{ steps.resolve.outputs.act }}
      head_sha: ${{ steps.resolve.outputs.head_sha }}
      pr: ${{ steps.resolve.outputs.pr }}
      candidate: ${{ steps.resolve.outputs.candidate }}
      candidate_pr: ${{ steps.resolve.outputs.candidate_pr }}
    steps:
      - name: Resolve the PR, its head commit and the bump candidate
        id: resolve
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          EVENT_NAME: ${{ github.event_name }}
          PR_NUMBER: ${{ github.event.pull_request.number || github.event.issue.number }}
          ACTOR_ID: ${{ github.event.comment.user.id || github.event.review.user.id }}
        run: |
          @@gate-resolve.sh@@

  decide:
    needs: resolve
    if: needs.resolve.outputs.act == 'true' && needs.resolve.outputs.candidate == 'true'
    permissions:        # a called workflow cannot exceed these
      contents: read
      pull-requests: read
    # >>> CONSUMER: decide pin
    # PLACEHOLDER: no v1.0 SHA exists yet, so the pin is 40 zeros (zizmor rejects a non-SHA
    # ref) and the comment says vX.Y. It cannot resolve, so a caller that keeps it fails to
    # start, which fails closed. PR 2 replaces it with `@<40-hex sha of the release> # v1.0`.
    uses: 603-Identity/devcontainers/.github/workflows/devcontainer-bump-decision.yml@0000000000000000000000000000000000000000 # vX.Y
    # <<< CONSUMER: decide pin
    with:
      head_sha: ${{ needs.resolve.outputs.head_sha }}
      candidate_pr: ${{ needs.resolve.outputs.candidate_pr }}

  post:
    needs: [resolve, decide]
    if: ${{ !cancelled() && needs.resolve.result == 'success' && needs.resolve.outputs.act == 'true' }}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      statuses: write       # post the `architect-review` commit status
      contents: write       # arm and disarm auto-merge
      pull-requests: write  # arm and disarm auto-merge
      issues: read          # PR comments, which the API serves as issue comments
    # One run at a time per (workflow, head SHA), so the status for a SHA comes from one
    # function run serially. GitHub keeps the last-queued run and cancels older PENDING ones
    # while a running one finishes (cancel-in-progress is false so a running post is never
    # cut short mid-write). `post` re-reads reviews and the kill switch when it starts, so
    # those are current. The workflow name is in the key so unrelated workflows never share a
    # group.
    concurrency:
      group: architect-review-${{ github.workflow }}-${{ needs.resolve.outputs.head_sha }}
      cancel-in-progress: false
    steps:
      - name: Compute the status and post it
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          PR: ${{ needs.resolve.outputs.pr }}
          HEAD_SHA: ${{ needs.resolve.outputs.head_sha }}
          CANDIDATE: ${{ needs.resolve.outputs.candidate }}
          CANDIDATE_PR: ${{ needs.resolve.outputs.candidate_pr }}
          DECIDE_RESULT: ${{ needs.decide.result }}
          EXEMPT: ${{ needs.decide.outputs.exempt }}
        run: |
          @@gate-post.sh@@
