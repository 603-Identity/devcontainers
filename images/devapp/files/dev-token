#!/bin/sh
# dev-token: the dev-App flavour's only GitHub credential source. It is the system git
# credential helper (`dev-token get`) and, for the gh wrapper, prints the bare token
# (`dev-token token`). It reads ONE file, /run/wow/dev-token, and never any other file in
# that directory: `admin-token` and anything else the host mounts there are not its business.
#
# Token-file contract (docs/threat_model.md, Untrusted inputs, the `/run/wow` row): line 1 is the token, line 2 is
# `expires_at` as UTC `YYYY-MM-DDTHH:MM:SSZ`, LF line endings, nothing else, replaced by atomic
# rename so a reader sees the old file or the new one, never half of either. The token is an
# installation token (`ghs_...`); anything else is refused.
#
# `get` answers a git credential request for https github.com and nothing else. Every other
# protocol or host, and every refusal (no file, a symlink, a malformed file, an expired
# token), answers `quit=1`, which tells git to stop asking other helpers and fail instead of
# prompting. The reason goes to stderr; a token never does. `store` and `erase` do nothing:
# this helper has no cache to write or clear.
#
# POSIX sh, no bashisms: it runs before anything else is trusted. PATH is fixed so a
# ~/.local/bin entry cannot stand in for `date` or `wc`.
PATH=/usr/local/bin:/usr/bin:/bin
export PATH
set -u
umask 077

TOKEN_FILE=/run/wow/dev-token
mode=${1:-}

refuse() { # refuse <reason>
    echo "dev-token: $1" >&2
    if [ "$mode" = get ]; then printf 'quit=1\n'; exit 0; fi
    exit 1
}

case "$mode" in
    get|token) ;;
    store|erase) cat >/dev/null 2>&1; exit 0 ;;
    *) echo "usage: dev-token get|token" >&2; exit 2 ;;
esac

if [ "$mode" = get ]; then
    # The request: key=value lines up to a blank line. Each of protocol and host must appear
    # exactly once. A duplicate is how a request tries to have two readers disagree.
    proto= ; host= ; np=0 ; nh=0
    while IFS= read -r line; do
        [ -n "$line" ] || break
        case "$line" in
            protocol=*) proto=${line#protocol=}; np=$((np + 1)) ;;
            host=*)     host=${line#host=};     nh=$((nh + 1)) ;;
        esac
    done
    [ "$np" = 1 ] && [ "$proto" = https ] || refuse "refusing: not an https request"
    [ "$nh" = 1 ] && [ "$host" = github.com ] || refuse "refusing: not github.com"
fi

[ -f "$TOKEN_FILE" ] && [ ! -L "$TOKEN_FILE" ] && [ -r "$TOKEN_FILE" ] \
    || refuse "no readable $TOKEN_FILE (is /run/wow mounted?)"

# Two lines of LF text and nothing more. The file is read ONCE, at most 513 bytes (the trailing
# `x` keeps $(...) from stripping the final newline), and every check below runs on that copy,
# so a rename landing mid-way cannot make the checks and the token come from different files.
# wc -l counts the newlines, so a file without its final one, or with a third line, fails.
data=$({ head -c 513 "$TOKEN_FILE" 2>/dev/null || exit 1; echo x; }) || refuse "cannot read $TOKEN_FILE"
data=${data%x}
size=$(printf '%s' "$data" | wc -c)
lines=$(printf '%s' "$data" | wc -l)
[ "$size" -gt 0 ] && [ "$size" -le 512 ] && [ "$lines" = 2 ] \
    || refuse "$TOKEN_FILE is not two lines of at most 512 bytes"
token=$(printf '%s\n' "$data" | sed -n 1p)
expires=$(printf '%s\n' "$data" | sed -n 2p)

# One expression per line: the tail of a CRLF file is a carriage return, which no class
# below allows.
printf '%s\n' "$token" | grep -Eq '^ghs_[A-Za-z0-9_]{20,255}$' || refuse "line 1 is not an installation token"
printf '%s\n' "$expires" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
    || refuse "line 2 is not a UTC expires_at"
exp_s=$(date -u -d "$expires" +%s 2>/dev/null) || refuse "line 2 is not a valid date"
now_s=$(date -u +%s) || refuse "cannot read the clock"
# 60 s of margin: a push that starts on a token with a second left fails half way through.
[ "$exp_s" -gt $((now_s + 60)) ] || refuse "the token expired, or expires within 60 s, at $expires"

if [ "$mode" = token ]; then
    printf '%s\n' "$token"
else
    printf 'protocol=https\nhost=github.com\nusername=x-access-token\npassword=%s\n' "$token"
fi
