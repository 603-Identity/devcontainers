{
  "extraKnownMarketplaces": {
    "claude-workbench": {
      "source": {
        "source": "github",
        "repo": "glunk-works/claude-workbench",
        "ref": "v0.15.0"
      }
    }
  },
  "enabledPlugins": {
    "way-of-working@claude-workbench": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-guard.sh\"" }
        ]
      }
    ]
  }
}
