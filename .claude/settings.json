{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "PowerShell(git commit --no-verify:*)",
      "PowerShell(git commit -n:*)",
      "PowerShell(git push --no-verify:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-guard.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "way-of-working@claude-workbench": true
  },
  "extraKnownMarketplaces": {
    "claude-workbench": {
      "source": {
        "source": "github",
        "repo": "glunk-works/claude-workbench",
        "ref": "v0.17.0"
      }
    }
  }
}
