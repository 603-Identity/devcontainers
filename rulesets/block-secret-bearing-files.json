{
  "name": "block-secret-bearing-files",
  "target": "push",
  "enforcement": "active",
  "bypass_actors": [],
  "rules": [
    { "type": "file_extension_restriction",
      "parameters": { "restricted_file_extensions": ["*.pfx", "*.p12", "*.pem", "*.key"] } },
    { "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": ["**/*.tfstate", "**/*.tfstate.*", "**/*.tfvars", "**/*.tfvars.json"],
        "ignored_file_paths": ["**/*.example.tfvars", "**/*.example.tfvars.json"] } }
  ]
}
